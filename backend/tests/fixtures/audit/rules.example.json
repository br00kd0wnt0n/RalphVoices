      "id": "F_SURG",
      "text": "Surgery can cost $6,000",
      "numbers": [
        "$6,000",
        "6,000"
      ],
      "source": "LEGAL \u00a71"
    },
    {
      "id": "F_CAT",
      "text": "40% of owners worry about bills",
      "numbers": [
        "40%"
      ],
      "source": "LEGAL \u00a72",
      "category": true
    }
  ],
  "figure_rule": {
    "id": "FIG_UNSOURCED",
    "rule": "Every figure comes from the facts list.",
    "severity": "compliance",
    "source": "LEGAL \u00a73",
    "citation_rule": {
      "id": "FIG_CITATION",
      "rule": "Category stats need a citation.",
      "source": "LEGAL \u00a73b"
    },
    "attribution_rule": {
      "id": "FIG_ATTRIBUTION",
      "rule": "Figures attributed correctly.",
      "source": "LEGAL \u00a73c"
    }
  },
  "compliance": [
    {
      "id": "COMP_DIRECT_PAY",
      "rule": "Direct pay is always stated with its caveat.",
      "severity": "compliance",
      "check": "require",
      "trigger_patterns": [
        "pa(y|ys|id)\\b[^.!?]{0,40}\\bvets?\\b[^.!?]{0,30}\\b(direct(ly)?|at checkout)"
      ],
      "requires_patterns": [
        "participating (hospital|clinic)"
      ],
      "wordings": [
        "Does it claim direct pay without the caveat?",
        "Is direct pay promised without the caveat?"
      ],
      "source": "LEGAL \u00a74"
    },
    {
      "id": "COMP_PAYS_FOR_ITSELF",
      "rule": "Never say it pays for itself.",
      "severity": "compliance",
      "check": "banned",
      "patterns": [
        "pa(y|ys|id) for (it|them)sel(f|ves)"
      ],
      "wordings": [
        "Does it say it pays for itself?",
        "Does it imply it saves more than it costs?"
      ],
      "source": "LEGAL \u00a75"
    },
    {
      "id": "COMP_PAID_SHARE",
      "rule": "Never say it pays the whole bill.",
      "severity": "compliance",
      "check": "banned",
      "patterns": [
        "pays? (the|your) (whole|entire|full) (vet )?(bill|cost)"
      ],
      "wordings": [
        "Does it say the whole bill is paid?",
        "Would a reader think they pay nothing?"
      ],
      "source": "LEGAL \u00a74b"
    },
    {
      "id": "COMP_SUPERLATIVE",
      "rule": "Superlatives need substantiation.",
      "severity": "warn",
      "check": "banned",
      "patterns": [
        {
          "re": "\\bbest\\b",
          "why": "Needs substantiation"
        }
      ],
      "source": "LEGAL \u00a76"
    },
    {
      "id": "COMP_UGC_MEMBER",
      "rule": "Real-person testimony must be members.",
      "severity": "note",
      "check": "structure",
      "structures": [
        "testimony"
      ],
      "source": "LEGAL \u00a77"
    }
  ],
